# Application
NODE_ENV=development
PORT=3000
APP_URL=https://your-domain.com
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_bot

# Redis
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_MODE=polling

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Speech-to-Text — Deepgram
# Get your key at https://console.deepgram.com
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cloudinary (for PDF/CSV report storage)
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=expense-bot

# Defaults
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

# Security
ENCRYPTION_KEY=your_32_char_encryption_key_here
